{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/inventory/**",
              "components/meal/**",
              "components/navigation/**",
              "screens/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|Be Vietnam Pro|Noto Sans Devanagari))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, Be Vietnam Pro, Noto Sans Devanagari."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|date|onDate|onBell|showBell|notifications|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: brand, date, onDate, onBell, showBell, notifications, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|uppercase|style|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, uppercase, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|saffron|active|locked|decided|success|warning|danger|info)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'saffron' | 'active' | 'locked' | 'decided' | 'success' | 'warning' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<NavTab> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|pill|fullWidth|disabled|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, pill, fullWidth, disabled, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|outline|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'outline' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComboItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hindi|emoji|diet|role|key|ref|className|style|children)$/]",
        "message": "<ComboItem> doesn't accept that prop. Declared props: name, hindi, emoji, diet, role."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComboItem'] > JSXAttribute[name.name='diet'] > Literal[value!=/^(?:veg|nonveg)$/]",
        "message": "<ComboItem> diet must be one of 'veg' | 'nonveg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:deadline|seconds|label|size|icon|variant|style|key|ref|className|style|children)$/]",
        "message": "<Countdown> doesn't accept that prop. Declared props: deadline, seconds, label, size, icon, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Countdown> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:stack|pill)$/]",
        "message": "<Countdown> variant must be one of 'stack' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DietBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|label|size|pill|style|key|ref|className|style|children)$/]",
        "message": "<DietBadge> doesn't accept that prop. Declared props: type, label, size, pill, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DietBadge'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:veg|nonveg)$/]",
        "message": "<DietBadge> type must be one of 'veg' | 'nonveg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='InventoryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hindi|emoji|variant|unit|qty|onQty|need|have|checked|onCheck|style|key|ref|className|style|children)$/]",
        "message": "<InventoryRow> doesn't accept that prop. Declared props: name, hindi, emoji, variant, unit, qty, onQty, need, have, checked, onCheck, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InventoryRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:stock|grocery)$/]",
        "message": "<InventoryRow> variant must be one of 'stock' | 'grocery'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MealCombo'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|diet|votes|items|vegVariant|winner|key|ref|className|style|children)$/]",
        "message": "<MealCombo> doesn't accept that prop. Declared props: letter, diet, votes, items, vegVariant, winner."
      },
      {
        "selector": "JSXOpeningElement[name.name='MealCombo'] > JSXAttribute[name.name='letter'] > Literal[value!=/^(?:A|B)$/]",
        "message": "<MealCombo> letter must be one of 'A' | 'B'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MealCombo'] > JSXAttribute[name.name='diet'] > Literal[value!=/^(?:veg|nonveg)$/]",
        "message": "<MealCombo> diet must be one of 'veg' | 'nonveg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QtyStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|step|min|max|unit|size|onChange|style|key|ref|className|style|children)$/]",
        "message": "<QtyStepper> doesn't accept that prop. Declared props: value, step, min, max, unit, size, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QtyStepper'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<QtyStepper> size must be one of 'sm' | 'md'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
